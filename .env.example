# --- HydraDB (local node) ---
HYDRA_URI=neo4j://127.0.0.1:7687
HYDRA_USER=neo4j
# contents of ~/hydra/engram-node/auth-token
HYDRA_PASSWORD=engram-local-dev-token-0000000000000000

# --- LLM: any OpenAI-compatible endpoint (Groq by default) ---
GROQ_API_KEY=your-groq-key-here
# Override the endpoint to use a different provider (e.g. local Ollama):
#   ENGRAM_LLM_BASE_URL=http://localhost:11434/v1
#   ENGRAM_LLM_KEY_ENV=OPENAI_API_KEY   # name of the env var holding the key
ENGRAM_LLM_BASE_URL=https://api.groq.com/openai/v1
ENGRAM_LLM_KEY_ENV=GROQ_API_KEY

# Per-role models (defaults shown). Cheap/fast for volume, stronger to answer.
ENGRAM_EXTRACT_MODEL=openai/gpt-oss-120b
ENGRAM_ANSWER_MODEL=openai/gpt-oss-120b
ENGRAM_JUDGE_MODEL=openai/gpt-oss-20b

# Throughput knobs (tune to your rate limits)
ENGRAM_EXTRACT_WORKERS=6
ENGRAM_EXTRACT_BATCH_CHARS=12000
