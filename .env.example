# --- HydraDB (local node) ---
HYDRA_URI=neo4j://127.0.0.1:7687
HYDRA_USER=neo4j
# contents of ~/hydra/engram-node/auth-token
HYDRA_PASSWORD=engram-local-dev-token-0000000000000000

# --- LLM: any OpenAI-compatible endpoint ---
# Recommended: OpenRouter (one key, many models, no per-day free-tier wall).
# gpt-4o-mini extracts consistent predicates + does tool-calling well and is cheap.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
ENGRAM_LLM_BASE_URL=https://openrouter.ai/api/v1
ENGRAM_LLM_KEY_ENV=OPENROUTER_API_KEY

ENGRAM_EXTRACT_MODEL=openai/gpt-4o-mini
ENGRAM_ANSWER_MODEL=openai/gpt-4o-mini
ENGRAM_JUDGE_MODEL=openai/gpt-4o-mini

# Throughput knobs
ENGRAM_EXTRACT_WORKERS=4
ENGRAM_EXTRACT_BATCH_CHARS=2500

# --- Other providers work too (per-role overrides are also supported) ---
# Groq:   ENGRAM_LLM_BASE_URL=https://api.groq.com/openai/v1  ENGRAM_LLM_KEY_ENV=GROQ_API_KEY
#         (free tier caps at 200k tokens/day per model — fine for a demo, not a full run)
# Ollama: ENGRAM_LLM_BASE_URL=http://localhost:11434/v1        ENGRAM_LLM_KEY_ENV=OPENAI_API_KEY
#         (needs a GPU; CPU inference is too slow for the benchmark)
# Per-role, e.g. keep extraction local but answer on a hosted model:
#   ENGRAM_EXTRACT_BASE_URL=http://localhost:11434/v1  ENGRAM_EXTRACT_KEY_ENV=OPENAI_API_KEY
